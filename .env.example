# Docker funktioniert lokal auch ohne diese Datei. Vor dem ersten Start nach .env
# kopieren, wenn die Vorgaben geändert werden sollen.
APP_PORT=3000
POSTGRES_PASSWORD=replace-with-a-long-random-password
DB_PORT=5432
SESSION_DAYS=30
ENVIRONMENT=development
COOKIE_SECURE=false
# Bei geändertem APP_PORT müssen beide URLs denselben Port verwenden.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ALLOWED_HOSTS=localhost,127.0.0.1

# Nur für den direkten Backend-Start auf dem Host. DATABASE_PASSWORD muss dabei
# denselben Wert wie POSTGRES_PASSWORD haben.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=verba
DATABASE_USER=verba
DATABASE_PASSWORD=replace-with-a-long-random-password
